rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.get('isAdmin', false) == true;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.get('role', '') == 'SUPER_ADMIN';
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && !request.resource.data.keys().hasAny(['isAdmin', 'role']);
      allow delete: if isSuperAdmin();
    }

    // ── Bills ──────────────────────────────────────────────────────────────────
    match /bills/{billId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // ── Subscriptions ──────────────────────────────────────────────────────────
    // Written only by Cloud Functions (admin SDK bypasses rules).
    // Users can read their own subscription. Admins can read all.
    match /subscriptions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // ── Subscription Events (audit trail) ─────────────────────────────────────
    match /subscription_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // ── Plans ──────────────────────────────────────────────────────────────────
    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── Trials ─────────────────────────────────────────────────────────────────
    match /trials/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // ── Payment Events ─────────────────────────────────────────────────────────
    match /payment_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // ── Feature Flags ──────────────────────────────────────────────────────────
    match /feature_flags/{flagId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── Notification Templates ─────────────────────────────────────────────────
    match /notification_templates/{templateId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // ── Admin Users ────────────────────────────────────────────────────────────
    match /admin_users/{adminId} {
      allow read: if isAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() && adminId != request.auth.uid; // Cannot demote self
      allow delete: if false; // Soft-delete only via Cloud Functions
    }

    // ── Admin Audit Logs (immutable) ───────────────────────────────────────────
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only — immutable
    }

    // Deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
