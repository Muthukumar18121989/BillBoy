# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.

# Firebase Admin SDK (server-side only — never expose to client)
FIREBASE_PROJECT_ID=billboy-1ff2c
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@billboy-1ff2c.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Firebase client config (safe to expose — these are public keys)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=billboy-1ff2c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=billboy-1ff2c
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=billboy-1ff2c.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=851190240105
NEXT_PUBLIC_FIREBASE_APP_ID=1:851190240105:web:XXXXXXXXXX

# Admin session secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
